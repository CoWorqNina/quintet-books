{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ggc-books",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // App URL: https://ggc-books.nina-99a.workers.dev (custom domain can be added later).
  "workers_dev": true,
  // No per-version preview links: they would run against the live Supabase and Airtable data.
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://vqfckhvepqvfmeltpicn.supabase.co",
    "AIRTABLE_BASE_ID": "appAWl68GqjTKpOSb"
  },
  // Secrets (set with `wrangler secret put` or in the Cloudflare dashboard, never committed):
  //   SUPABASE_SECRET_KEY  - Supabase secret key (sb_secret_...), server only
  //   AIRTABLE_TOKEN       - Airtable personal access token scoped to the GGC Books base
  // Nightly ledger backup at 2:00 AM Manila time (18:00 UTC).
  "triggers": { "crons": ["0 18 * * *"] },
  "observability": { "enabled": true }
}
